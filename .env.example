# Copiar para .env (que não vai para o Git) e substituir os valores.
# Gerar um segredo: python -c "import secrets; print(secrets.token_hex(32))"

# Segredo para assinar/validar os tokens JWT (HS256)
JWT_SECRET=substituir-por-um-segredo-aleatorio

# Chave HMAC-SHA256 da pseudonimização (diferente do JWT_SECRET)
PSEUDONIM_KEY=substituir-por-outra-chave-aleatoria
